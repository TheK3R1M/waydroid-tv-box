auto lo
iface lo inet loopback

# Fiziksel kartlar (boşta)
iface nic0 inet manual
iface nic1 inet manual

# Wi-Fi Kartı (Ana Bağlantı ve Proxmox Erişim IP'si)
auto wlp3s0
iface wlp3s0 inet static
        address __TV_HOST_IP__/24
        gateway __GATEWAY_IP__
        dns-nameservers __GATEWAY_IP__

# Sanal Makineler ve Container'lar için İç Ağ Köprüsü
auto vmbr0
iface vmbr0 inet static
        address 10.10.10.1/24
        bridge-ports none
        bridge-stp off
        bridge-fd 0
        post-up echo 1 > /proc/sys/net/ipv4/ip_forward
        post-up iptables -t nat -A POSTROUTING -s '10.10.10.0/24' -o wlp3s0 -j MASQUERADE
        post-down iptables -t nat -D POSTROUTING -s '10.10.10.0/24' -o wlp3s0 -j MASQUERADE

source /etc/network/interfaces.d/*
