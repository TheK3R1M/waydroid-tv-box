<?xml version="1.0" encoding="utf-8"?>
<!-- TV Klavye: on-screen Turkish keyboard IME + ADBKeyboard-compatible injection. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.tvbox.klavye" android:versionCode="9" android:versionName="4.0.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />
    <application android:label="TV Klavye" android:allowBackup="false">
        <service android:name=".KlavyeIME"
            android:label="TV Klavye"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <!-- SET works before the IME was ever shown (no runtime registration needed). DUMP = adb shell only. -->
        <receiver android:name=".SetRx"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.tvbox.klavye.SET" />
            </intent-filter>
        </receiver>
        <activity android:name=".SettingsActivity"
            android:label="TV Klavye Settings"
            android:exported="true" />
    </application>
</manifest>
